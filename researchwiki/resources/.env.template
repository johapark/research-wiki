# Copy this file to `.env` for the automatically loaded default profile, then
# preferably restrict it before adding credentials:
#   cp .env.template .env && chmod 600 .env
# For a named profile, keep it separate and select it explicitly:
#   cp .env.template .env.litellm && chmod 600 .env.litellm
#   researchwiki --env-file .env.litellm init
#   researchwiki --env-file .env.litellm status
#
# `init` creates a mutable, gitignored config for each named profile and writes
# this selector automatically. Manual named-profile example:
# RW_MODELS_CONFIG=config/profiles/litellm.yaml
# Tracked config/models.*.yaml files are immutable templates; copy one into the
# profile path rather than editing it. Leave this unset for built-in OpenAI.

# Optional OpenAI-compatible endpoint. Leave unset when using the endpoint in
# the selected model config. HTTP and HTTPS are accepted; use only endpoints
# you trust because the selected API key and paper content are sent there.
# RW_LLM_BASE_URL=http://your-litellm-host/v1

# API credential for the selected endpoint. Never commit an actual key.
# OPENAI_API_KEY=your-litellm-api-key
