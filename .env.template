# Copy this file to `.env` for the default profile, or to a named profile such
# as `.env.litellm` and load it with `source .env.litellm` before running
# `researchwiki`.
#
# Select the model-routing file under config/. `models.yaml` is the live
# OpenAI-compatible configuration; named configs can be selected directly.
RW_MODELS_CONFIG=models.yaml

# Optional OpenAI-compatible endpoint. Leave unset when using the endpoint in
# the selected model config.
# RW_LLM_BASE_URL=https://your-litellm-host/v1

# API credential for the selected endpoint. Never commit an actual key.
# OPENAI_API_KEY=your-litellm-api-key
